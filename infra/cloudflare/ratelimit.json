{
  "rules": [
    {
      "ref": "charpub_auth_ratelimit",
      "description": "char.pub: sign-in endpoints, per IP",
      "expression": "(http.host in {\"api.char.pub\"}) and starts_with(http.request.uri.path, \"/v1/auth/\")",
      "action": "block",
      "ratelimit": {
        "characteristics": ["ip.src", "cf.colo.id"],
        "period": 10,
        "requests_per_period": 20,
        "mitigation_timeout": 10
      },
      "enabled": true
    }
  ]
}
