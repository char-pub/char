{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "incremental": false,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": [
    "packages/*/src/**/*.test.ts",
    "packages/*/test/**/*.ts",
    "packages/*/scripts/**/*.ts",
    "apps/server/src/**/*.test.ts",
    "apps/server/test/**/*.ts",
    "actions/*/src/**/*.test.ts",
    "apps/server/*.config.ts",
    "apps/server/vitest.shared.ts",
    "vitest.config.ts"
  ]
}
