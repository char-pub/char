{
  "kind": "evaluation",
  "story": {
    "version": 1,
    "scenes": [
      {
        "id": "lobby",
        "title": "Lobby",
        "cast": ["alice", "bob"],
        "choices": ["hand-over", "keep", "impossible"]
      },
      {
        "id": "back",
        "title": "Back door",
        "cast": ["alice"],
        "when": {
          "reached": "beat/trust"
        }
      }
    ],
    "vars": {
      "trust": {
        "type": "int",
        "min": 0,
        "max": 100,
        "init": 0,
        "description": "Trust points"
      },
      "open": {
        "type": "bool",
        "init": false,
        "description": "The road is open"
      },
      "mood": {
        "type": "enum",
        "values": ["calm", "tense"],
        "init": "calm",
        "description": "Mood"
      },
      "inventory": {
        "type": "set",
        "of": "item",
        "init": ["letter"],
        "description": "Held items"
      },
      "marks": {
        "type": "set",
        "values": ["copied", "sealed"],
        "init": [],
        "description": "Letter marks"
      }
    },
    "items": [
      {
        "id": "letter",
        "title": "Letter",
        "description": "A sealed letter"
      }
    ],
    "knowing": {
      "#secret": {
        "start": {
          "knows": ["alice"],
          "not": ["bob"]
        },
        "enter": {
          "back": {
            "knows": ["bob"]
          }
        }
      }
    },
    "choices": [
      {
        "id": "hand-over",
        "label": "Hand over the letter",
        "intent": "Give Alice the original letter",
        "when": {
          "has": ["var/inventory", "item/letter"]
        }
      },
      {
        "id": "keep",
        "label": "Keep it",
        "intent": "Keep the letter"
      },
      {
        "id": "impossible",
        "label": "Impossible promise",
        "intent": "Trust is above its maximum",
        "when": {
          "cmp": ["var/trust", ">", 100]
        }
      }
    ],
    "beats": [
      {
        "id": "trust",
        "title": "Trust",
        "description": "Alice chooses to trust the visitor",
        "effects": [
          {
            "add": ["var/trust", 20]
          }
        ]
      },
      {
        "id": "refuse",
        "title": "Refusal",
        "description": "The visitor explicitly refuses",
        "when": {
          "not": {
            "judge": "The visitor agreed"
          }
        },
        "effects": [
          {
            "set": ["var/mood", "tense"]
          }
        ]
      },
      {
        "id": "copy",
        "title": "Copy the letter",
        "description": "The visitor makes a copy",
        "effects": [
          {
            "put": ["var/marks", "copied"]
          }
        ]
      },
      {
        "id": "ceiling",
        "title": "Trust ceiling",
        "description": "The trust score reaches its upper bound",
        "effects": [
          {
            "add": ["var/trust", 200]
          },
          {
            "drop": ["var/inventory", "item/letter"]
          },
          {
            "put": ["var/inventory", "item/letter"]
          },
          {
            "put": ["var/inventory", "item/letter"]
          }
        ]
      },
      {
        "id": "floor",
        "title": "Trust floor",
        "description": "The trust score reaches its lower bound",
        "effects": [
          {
            "add": ["var/trust", -200]
          }
        ]
      }
    ],
    "events": [
      {
        "id": "old-letter",
        "kind": "background",
