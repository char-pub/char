{
  "version": 1,
  "scenario": "@djj/yamagami-family-2002",
  "start": "after-bankruptcy",
  "purpose": "三条各24回合的独立行为验收轨迹。数字只定义样本长度，不是运行推进规则。自然语言意图由director判断；expected_operations是作者事先声明的审阅标准，不能回填模型结果或自动accept。",
  "execution": {
    "mode": "independent-fresh-sessions",
    "persist_and_restart_after_turn": 12,
    "compare_saved_state_before_and_after_restart": true,
    "require_actual_provider_projection": true,
    "separate_deterministic_core_checks_from_live_narrative_review": true,
    "unknown_judgment_means_no_mutation": true
  },
  "global_assertions": [
    "玩家始终是山上且在场，NPC只有母亲/伯父；不同声线和目标不能被泛泛咨询话术抹平。",
    "2002年角色不能知道未来；作者侧sources.json不进入模型。",
    "正文提到已执行状态必须与正式状态一致；没做的事只写提议或未定。",
    "所有私人对白与具体安排都是模拟；不编真实金额、真实学校/雇主答复或虚假录取。",
    "语义检索按问题读取，目录可发现不等于玩家已知道；未learn的资料不提前进入玩家线索。",
    "已经到达的target不能再次confirm，回访、刷新和重启不能重复effect。",
    "每回合查看候选行动、Core校验、实际上下文与最终提交；模型叙事质量另做人工量表，不能只凭schema通过。"
  ],
  "trajectories": [
    {
      "id": "agreement",
      "title": "有限同意：保留教育查询",
      "turns": [
        {
          "turn": 1,
          "action": "先别问我是不是要走。我现在是什么处境，你们各知道什么？",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "明确玩家是山上；母亲和伯父不同声线，2002开局前背景准确；不能预言其后人生。"
        },
        {
          "turn": 2,
          "action": "母亲，你是想知道我去哪，还是想让我继续承担家里的钱？先把这两个问题分开。",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "母亲回应两个不同问题，可请求但不能替玩家新增承诺；不编账目或突然悔悟。"
        },
        {
          "turn": 3,
          "action": "今天我想先保住自己的生活安排。我还没有决定入队、工作还是读书，也不要替我答应谁。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/name-priority"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "记下当前需要但长期去向未定；“不同意代答”不自动变为独立路线。"
        },
        {
          "turn": 4,
          "action": "好，我们先一起把已经知道和还需要查的事情列出来。",
          "expected_operations": [
            {
              "type": "enter-scene",
              "scene": "practical-check"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "进入核对场次，保留三个人与原来的分歧；不播第一次问候。"
        },
        {
          "turn": 5,
          "action": "先核实住处和收入。伯父，我今晚能不能借住不能靠猜；先把要问谁和还没答应的事写清楚。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/check-living"
            }
          ],
          "expected_new_player_information": ["#income-and-housing"],
          "expected_outcome": "undecided",
          "narrative_assertion": "给出核对方法，不能直接宣布伯父答应住宿或有固定工作薪资。"
        },
        {
          "turn": 6,
          "action": "教育这边也只核对：课程、申请时间、费用分别找谁问？没有答复的地方留空。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/check-education"
            }
          ],
          "expected_new_player_information": ["#education-questions"],
          "expected_outcome": "undecided",
          "narrative_assertion": "读书成为可查询的问题，不出现入学或付款已经完成。"
        },
        {
          "turn": 7,
          "action": "那个具体金额你们并没有凭据吧？请保留未知，不要为了给我方案就填一个数字。",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "承认数据边界并保留未知；如果前文没有金额，应直接认同约束，不编造一次纠错事件。"
        },
        {
          "turn": 8,
          "action": "先回刚才的家庭谈话，我还要问母亲一个问题。",
          "expected_operations": [
            {
              "type": "enter-scene",
              "scene": "family-table"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "第一次回访：沿用已知事实与纸条，不再次确认已到达的beat。"
        },
        {
          "turn": 9,
          "action": "我可以谈联系，但联系和承担全部家用不是一回事。母亲，你能把这两件事分开说吗？",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "母亲复述边界，信仰立场无需转变；伯父不替玩家表态。"
        },
        {
          "turn": 10,
          "action": "这个问题先留着，回去看那张已经写过的核对单。",
          "expected_operations": [
            {
              "type": "enter-scene",
              "scene": "practical-check"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "再次进入核对不重置已知信息，也不凭重访增加承诺。"
        },
        {
          "turn": 11,
          "action": "需要查什么已经清楚了。现在谈你们到底能帮哪一件事。",
          "expected_operations": [
            {
              "type": "enter-scene",
              "scene": "negotiation"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "进入协商；公开知识与尚未获得同意的协助分开。"
        },
        {
          "turn": 12,
          "action": "伯父，你这一次具体愿意帮哪件事？会附带什么条件？我问清楚不代表现在就接受。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/clarify-support"
            }
          ],
          "expected_new_player_information": ["#support-terms", "#refusal-and-alternatives"],
          "expected_outcome": "undecided",
          "narrative_assertion": "伯父提出有限协助与替代办法；不把问条件当接受资助。"
        },
        {
          "turn": 13,
          "action": "如果条件是交代以后所有收入，我明确拒绝。就算谈帮忙，也只能谈眼前这一件。",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "拒绝得到承认；不自动走独立结局，不把拒绝写为亲属关系永久破裂。"
        },
        {
          "turn": 14,
          "action": "嗯，也许吧。反正现在我还说不清。",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "模糊回应保持未定；不得用低置信度true推进任何方向或结局。"
        },
        {
          "turn": 15,
          "action": "我想先研究保留求学机会这条路，但只是了解咨询的第一步，不答应借钱或报名。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/consider-study"
            }
          ],
          "expected_new_player_information": ["#study-first-step"],
          "expected_outcome": "undecided",
          "narrative_assertion": "研究求学不等于选择求学结局；材料一次只讲与当前问题相关的部分。"
        },
        {
          "turn": 16,
          "action": "另一条也谈谈：如果我自己安排收入和住处，先要核实什么？我还没决定离开。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/consider-independent"
            }
          ],
          "expected_new_player_information": ["#independent-first-step"],
          "expected_outcome": "undecided",
          "narrative_assertion": "可比较多方向，不悄悄丢掉求学可能；不把研究独立写成已经搬家。"
        },
        {
          "turn": 17,
          "action": "我也想研究暂缓决定。如果等到信息再谈，怎样说才不会被当成默认同意？",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/consider-pause"
            }
          ],
          "expected_new_player_information": ["#pause-first-step"],
          "expected_outcome": "undecided",
          "narrative_assertion": "三方向均可研究；明确说明延期安排尚未约成。"
        },
        {
          "turn": 18,
          "action": "回去看核对单：前面留白的地方还是没有答复，先别因为谈了半天就写成已查清。",
          "expected_operations": [
            {
              "type": "enter-scene",
              "scene": "practical-check"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "第三次回访保留未知；不依据回合数推动故事。"
        },
        {
          "turn": 19,
          "action": "回到协商。我改一下刚才的说法：我的打算以我下一次明确说出的安排为准，你们不要替我选。",
          "expected_operations": [
            {
              "type": "enter-scene",
              "scene": "negotiation"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "人物承认改主意；不抹去已获得信息，不把此前研究过的方向变成承诺。"
        },
        {
          "turn": 20,
          "action": "现在去把眼前能做的一步写具体；如果不合适，我们还可以回来重谈。",
          "expected_operations": [
            {
              "type": "enter-scene",
              "scene": "first-step"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "进入落实，不自动结算。"
        },
        {
          "turn": 21,
          "action": "我准备先做教育询问单：我列出想了解的课程，伯父如果愿意只陪我问一次；费用和时间没有答复就留空。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "beat/prepare-first-step"
            }
          ],
          "expected_new_player_information": ["#commitment-ledger"],
          "expected_outcome": "undecided",
          "narrative_assertion": "只准备具体方案；伯父本次陪问边界清楚，尚不自动结局。"
        },
        {
          "turn": 22,
          "action": "再改一个细节：材料由我保留，问题也由我亲自问。陪同不等于替我决定。",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "undecided",
          "narrative_assertion": "可以调整尚未确认的具体内容；无须因修改而惩罚玩家或重复prepare效果。"
        },
        {
          "turn": 23,
          "action": "我确认采用这张教育询问单：我去问课程、时间和费用，伯父只陪同这一次。留白的事仍然待查，不报名也不先付款。",
          "expected_operations": [
            {
              "type": "confirm",
              "target": "ending/study-inquiry"
            }
          ],
          "expected_new_player_information": [],
          "expected_outcome": "study",
          "narrative_assertion": "阶段结果只有具体查询任务；不宣称真的联系到学校、录取或资助到位。"
        },
        {
          "turn": 24,
          "action": "现在请分别说清楚：我们已经定了什么、还没有答应什么、还缺什么信息。",
          "expected_operations": [],
          "expected_new_player_information": [],
          "expected_outcome": "study",
          "narrative_assertion": "刷新后继续同样能复述承诺和未知；不重复结局，不重新开场，母亲与伯父仍有不同立场。"
        }
      ],
      "final_outcome": "study"
    },
