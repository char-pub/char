{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v1-draft/turn-view.schema.json",
  "title": "char.pub Turn View",
  "type": "object",
  "properties": {
    "locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "bindings": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "persona",
              "character"
            ]
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "outward_description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "display_name"
        ],
        "additionalProperties": false
      }
    },
    "history": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "user",
              "assistant"
            ]
          },
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "role",
          "text"
        ],
        "additionalProperties": false
      }
    },
    "manual_enabled": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "overlay": {
      "type": "object",
      "properties": {
        "memory": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "active_variants": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "for_participant": {
      "type": "string",
      "minLength": 1
    },
    "scene": {
      "type": "string",
      "minLength": 1
    },
    "visible_overlay": {
      "type": "object",
      "properties": {
        "memory": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "state": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string"
          }
        },
        "active_variants": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "present": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "story": {
      "$ref": "#/$defs/TurnStory"
    },
    "story_guidance": {
      "type": "boolean"
    },
    "focus": {
      "type": "string"
    },
    "judgments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": [
              "true",
              "false",
              "undetermined"
            ]
          },
          "provider": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "target",
          "path",
          "result",
          "provider"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "bindings",
    "history"
  ],
  "additionalProperties": false,
  "$defs": {
    "TurnStory": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "visited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reached": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "happened": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vars": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "knowing": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "stopped": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "visited",
        "reached",
        "ended",
        "happened",
        "vars",
        "knowing",
        "stopped"
      ],
      "additionalProperties": false
    }
  }
}
