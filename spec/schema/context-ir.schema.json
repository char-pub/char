{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v0-draft/context-ir.schema.json",
  "title": "char.pub Context IR",
  "type": "object",
  "properties": {
    "ir_version": {
      "type": "string",
      "const": "0-draft"
    },
    "root": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "ref",
        "release",
        "semantic_digest"
      ],
      "additionalProperties": false
    },
    "lock_digest": {
      "$ref": "#/$defs/Digest"
    },
    "resolver": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "meta": {
      "$ref": "#/$defs/EffectiveMeta"
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Participant"
      }
    },
    "late_slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LateSlot"
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IRFragment"
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "greetings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "speaker": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "locales": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/Locale"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "scenario_hint": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "speaker",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "greetings"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IRAsset"
      }
    },
    "graph": {
      "$ref": "#/$defs/IRGraph"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "subject",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ir_version",
    "root",
    "lock_digest",
    "resolver",
    "meta",
    "participants",
    "late_slots",
    "fragments",
    "bootstrap",
    "assets",
    "graph",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "UnversionedRef": {
      "type": "string",
      "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EffectiveMeta": {
      "type": "object",
      "properties": {
        "default_locale": {
          "$ref": "#/$defs/Locale"
        },
        "available_locales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Locale"
          }
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        },
        "rating_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "rating": {
                "$ref": "#/$defs/Rating"
              },
              "asset": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "rating"
            ],
            "additionalProperties": false
          }
        },
        "content_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "license": {
                "$ref": "#/$defs/SpdxExpression"
              },
              "asset": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "license"
            ],
            "additionalProperties": false
          }
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "authors": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/AttributionAuthor"
                }
              }
            },
            "required": [
              "ref",
              "authors"
            ],
            "additionalProperties": false
          }
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "author": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                  },
                  {
                    "$ref": "#/$defs/GuestAuthor"
                  }
                ]
              },
              "contribution": {
                "type": "string",
                "pattern": "^ctb_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              }
            },
            "required": [
              "ref",
              "author"
            ],
            "additionalProperties": false
          }
        },
        "import_omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ref",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "au": {
          "type": "boolean"
        },
        "recommended_presets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnversionedRef"
          }
        }
      },
      "required": [
        "default_locale",
        "available_locales",
        "rating",
        "rating_sources",
        "content_warnings",
        "licenses",
        "attribution",
        "contributors",
        "import_omissions",
        "au",
        "recommended_presets"
      ],
      "additionalProperties": false
    },
    "Locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "Rating": {
      "type": "string",
      "enum": [
        "general",
        "teen",
        "mature",
        "explicit"
      ]
    },
    "SpdxExpression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9.+\\-() :]+$"
    },
    "AttributionAuthor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "user": {
          "type": "string",
          "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "guest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contribution": {
          "type": "string",
          "pattern": "^ctb_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "GuestAuthor": {
      "type": "object",
      "properties": {
        "guest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "guest_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "Participant": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "display_name": {
          "$ref": "#/$defs/LocalizedText"
        },
        "kind": {
          "type": "string",
          "enum": [
            "character",
            "persona"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "lead",
            "support",
            "user"
          ]
        },
        "late": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "display_name",
        "kind"
      ],
      "additionalProperties": false
    },
    "LocalizedText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "LateSlot": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "accepts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "persona",
              "character"
            ]
          }
        },
        "required": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "used_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "key",
        "accepts",
        "required",
        "used_by"
      ],
      "additionalProperties": false
    },
    "IRFragment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "content": {
          "$ref": "#/$defs/IRContent"
        },
        "locales": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "$ref": "#/$defs/IRContent"
          }
        },
        "activation": {
          "$ref": "#/$defs/Activation"
        },
        "visibility": {
          "$ref": "#/$defs/IRVisibility"
        },
        "importance": {
          "type": "string",
          "enum": [
            "pinned",
            "normal",
            "opportunistic"
          ]
        },
        "placement_hint": {
          "$ref": "#/$defs/FragmentKind"
        },
        "subject": {
          "type": "string"
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "kind",
        "content",
        "activation",
        "visibility",
        "importance",
        "placement_hint",
        "origin",
        "digest"
      ],
      "additionalProperties": false
    },
    "FragmentKind": {
      "type": "string",
      "enum": [
        "character",
        "persona",
        "relationship",
        "world",
        "scenario",
        "knowledge",
        "style",
        "examples",
        "instruction"
      ]
    },
    "IRContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "markdown",
                "plain"
              ]
            }
          },
          "required": [
            "type",
            "text",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dialogue"
            },
            "turns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "speaker": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "speaker",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "turns"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "media"
            },
            "asset": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "asset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "structured"
            },
            "schema": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/JSONValue"
            }
          },
          "required": [
            "type",
            "schema",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    },
    "Activation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "always"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "keyword"
            },
            "keys": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "logic": {
              "type": "string",
              "enum": [
                "any",
                "all"
              ]
            },
            "case_sensitive": {
              "type": "boolean"
            },
            "whole_word": {
              "type": "boolean"
            },
            "scan_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "mode",
            "keys"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "semantic"
            },
            "hint": {
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "IRVisibility": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "shared"
            }
          },
          "required": [
            "scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "private"
            },
            "to": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "scope",
            "to"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "scene"
            },
            "scene": {
              "type": "string"
            }
          },
          "required": [
            "scope",
            "scene"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Origin": {
      "type": "object",
      "properties": {
        "creation": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "fragment": {
          "$ref": "#/$defs/FragmentId"
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          }
        },
        "instance_key": {
          "type": "string"
        },
        "overridden_by": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "creation": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "edge": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
              },
              "op": {
                "type": "string",
                "enum": [
                  "replace",
                  "patch",
                  "add"
                ]
              }
            },
            "required": [
              "creation",
              "op"
            ],
            "additionalProperties": false
          }
        },
        "stable": {
          "type": "boolean"
        }
      },
      "required": [
        "creation",
        "release",
        "fragment",
        "via",
        "instance_key",
        "stable"
      ],
      "additionalProperties": false
    },
    "FragmentId": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?(?:\\/[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?){0,3}$"
    },
    "IRAsset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "presentation",
            "context"
          ]
        },
        "media_type": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "availability": {
          "type": "string",
          "enum": [
            "mirrored",
            "linked"
          ]
        },
        "access": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        },
        "url": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "alt": {
          "type": "string"
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        },
        "license": {
          "$ref": "#/$defs/SpdxExpression"
        },
        "origin": {
          "type": "object",
          "properties": {
            "creation": {
              "$ref": "#/$defs/UnversionedRef"
            },
            "release": {
              "type": "string",
              "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
            },
            "slot": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "variant": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "instance_key": {
              "type": "string"
            }
          },
          "required": [
            "creation",
            "release",
            "slot",
            "variant",
            "instance_key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "role",
        "media_type",
        "digest",
        "availability",
        "access",
        "rating",
        "license",
        "origin"
      ],
      "additionalProperties": false
    },
    "SourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "github"
            },
            "repository_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "repository_id",
            "commit",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "http"
            },
            "url": {
              "type": "string",
              "pattern": "^https:\\/\\/",
              "format": "uri"
            }
          },
          "required": [
            "provider",
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "IRGraph": {
      "type": "object",
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "release": {
                "type": "string",
                "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              },
              "type": {
                "$ref": "#/$defs/CreationType"
              },
