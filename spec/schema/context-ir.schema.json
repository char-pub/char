{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v1-draft/context-ir.schema.json",
  "title": "char.pub Context IR",
  "type": "object",
  "properties": {
    "ir_version": {
      "type": "string",
      "const": "1-draft"
    },
    "root": {
      "$ref": "#/$defs/PresetIdentity"
    },
    "lock_digest": {
      "$ref": "#/$defs/Digest"
    },
    "resolver": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "meta": {
      "$ref": "#/$defs/EffectiveMeta"
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Participant"
      }
    },
    "late_slots": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LateSlot"
      }
    },
    "fragments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IRFragment"
      }
    },
    "bootstrap": {
      "type": "object",
      "properties": {
        "greetings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "speaker": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "locales": {
                "type": "object",
                "propertyNames": {
                  "$ref": "#/$defs/Locale"
                },
                "additionalProperties": {
                  "type": "string"
                }
              },
              "scenario_hint": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "greetings"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/IRAsset"
      }
    },
    "graph": {
      "$ref": "#/$defs/IRGraph"
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning"
            ]
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "subject",
          "severity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "ir_version",
    "root",
    "lock_digest",
    "resolver",
    "meta",
    "participants",
    "late_slots",
    "fragments",
    "bootstrap",
    "assets",
    "graph",
    "diagnostics"
  ],
  "additionalProperties": false,
  "$defs": {
    "PresetIdentity": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "semantic_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "release": {
              "type": "string",
              "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
            }
          },
          "required": [
            "ref",
            "semantic_digest",
            "release"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "semantic_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "origin": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "draft-build"
                    },
                    "build_id": {
                      "type": "string",
                      "pattern": "^dbld_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^rev_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "kind",
                    "build_id",
                    "revision",
                    "expires_at"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "local-build"
                    },
                    "input_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "input_digest"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "ref",
            "semantic_digest",
            "origin"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EffectiveMeta": {
      "type": "object",
      "properties": {
        "default_locale": {
          "$ref": "#/$defs/Locale"
        },
        "available_locales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Locale"
          }
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        },
        "rating_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "rating": {
                "$ref": "#/$defs/Rating"
              },
              "asset": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "rating"
            ],
            "additionalProperties": false
          }
        },
        "content_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "license": {
                "$ref": "#/$defs/SpdxExpression"
              },
              "asset": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "license"
            ],
            "additionalProperties": false
          }
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "authors": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/AttributionAuthor"
                }
              }
            },
            "required": [
              "ref",
              "authors"
            ],
            "additionalProperties": false
          }
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "client_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "author": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                  },
                  {
                    "$ref": "#/$defs/GuestAuthor"
                  }
                ]
              },
              "contribution": {
                "type": "string",
                "pattern": "^ctb_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              },
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              }
            },
            "required": [
              "author",
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "import_omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ref",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "au": {
          "type": "boolean"
        },
        "recommended_presets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnversionedRef"
          }
        }
      },
      "required": [
        "default_locale",
        "available_locales",
        "rating",
        "rating_sources",
        "content_warnings",
        "licenses",
        "attribution",
        "contributors",
        "import_omissions",
        "au",
        "recommended_presets"
      ],
      "additionalProperties": false
    },
    "Locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "Rating": {
      "type": "string",
      "enum": [
        "general",
        "teen",
        "mature",
        "explicit"
      ]
    },
    "UnversionedRef": {
      "type": "string",
      "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "SpdxExpression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9.+\\-() :]+$"
    },
    "AttributionAuthor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "user": {
          "type": "string",
          "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "guest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contribution": {
          "type": "string",
          "pattern": "^ctb_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "GuestAuthor": {
      "type": "object",
      "properties": {
        "guest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "guest_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "Participant": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "cast_key": {
          "type": "string"
        },
        "cast_scope": {
          "type": "string"
        },
        "part": {
          "$ref": "#/$defs/LocalizedText"
        },
        "goal": {
          "$ref": "#/$defs/LocalizedText"
        },
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "display_name": {
          "$ref": "#/$defs/LocalizedText"
        },
        "kind": {
          "type": "string",
          "enum": [
            "character",
            "persona"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "lead",
            "support",
            "user"
          ]
        },
        "late": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "display_name",
        "kind"
      ],
      "additionalProperties": false
    },
    "LocalizedText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "LateSlot": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "accepts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "persona",
              "character"
            ]
          }
        },
        "required": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "used_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "key",
        "accepts",
        "required",
        "used_by"
      ],
      "additionalProperties": false
    },
    "IRFragment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "description": {
          "$ref": "#/$defs/LocalizedText"
        },
        "selectable": {
          "type": "boolean"
        },
        "outward": {
          "type": "boolean"
        },
        "perspective": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "canon",
                "rumor"
              ]
            },
            {
              "type": "object",
              "properties": {
                "claim": {
                  "type": "string",
                  "pattern": "^participant:.+$"
                }
              },
              "required": [
                "claim"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "belief": {
                  "type": "string",
                  "pattern": "^participant:.+$"
                }
              },
              "required": [
                "belief"
              ],
              "additionalProperties": false
            }
          ]
        },
        "about": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "source": {
          "type": "object",
          "properties": {
            "use": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "use"
          ],
          "additionalProperties": false
        },
        "instance": {
          "type": "string"
        },
        "style_scope": {
          "anyOf": [
            {
              "type": "string",
              "const": "narration"
            },
            {
              "type": "object",
              "properties": {
                "scene": {
                  "type": "string"
                },
                "owner": {
                  "type": "string"
                }
              },
              "required": [
                "scene",
                "owner"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "participant": {
                  "type": "string"
                }
              },
              "required": [
                "participant"
              ],
              "additionalProperties": false
            }
          ]
        },
        "style_use": {
          "type": "object",
          "properties": {
            "owner": {
              "type": "string"
            },
            "order": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "combine": {
              "type": "string",
              "enum": [
                "add",
                "replace"
              ]
            },
            "path": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "owner": {
                    "type": "string"
                  },
                  "order": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "combine": {
                    "type": "string",
                    "enum": [
                      "add",
                      "replace"
                    ]
                  }
                },
                "required": [
                  "owner",
                  "order",
                  "combine"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "owner",
            "order",
            "combine"
          ],
          "additionalProperties": false
        },
        "content": {
          "$ref": "#/$defs/IRContent"
        },
        "locales": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "$ref": "#/$defs/IRContent"
          }
        },
        "activation": {
          "$ref": "#/$defs/Activation"
        },
        "visibility": {
          "$ref": "#/$defs/IRVisibility"
        },
        "importance": {
          "type": "string",
          "enum": [
            "pinned",
            "normal",
            "opportunistic"
          ]
        },
        "placement_hint": {
          "$ref": "#/$defs/FragmentKind"
        },
        "subject": {
          "type": "string"
        },
        "asset_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "id",
        "kind",
        "content",
        "activation",
        "visibility",
        "importance",
        "placement_hint",
        "origin",
        "digest"
      ],
      "additionalProperties": false
    },
    "FragmentKind": {
      "type": "string",
      "enum": [
        "character",
        "persona",
        "relationship",
        "world",
        "scenario",
        "knowledge",
        "style",
        "examples",
        "instruction"
      ]
    },
    "IRContent": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "text"
            },
            "text": {
              "type": "string"
            },
            "format": {
              "type": "string",
              "enum": [
                "markdown",
                "plain"
              ]
            }
          },
          "required": [
            "type",
            "text",
            "format"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dialogue"
            },
            "turns": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "speaker": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "speaker",
                  "text"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "turns"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "media"
            },
            "asset": {
              "type": "string"
            },
            "caption": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "asset"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "structured"
            },
            "schema": {
              "type": "string"
            },
            "data": {
              "$ref": "#/$defs/JSONValue"
            }
          },
          "required": [
            "type",
            "schema",
            "data"
          ],
          "additionalProperties": false
        }
      ]
    },
    "JSONValue": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/JSONValue"
          }
        },
        {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "$ref": "#/$defs/JSONValue"
          }
        }
      ]
    },
    "Activation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "always"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "keyword"
            },
            "keys": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "secondary": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "logic": {
              "type": "string",
              "enum": [
                "any",
                "all"
              ]
            },
            "case_sensitive": {
              "type": "boolean"
            },
            "whole_word": {
              "type": "boolean"
            },
            "scan_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          "required": [
            "mode",
            "keys"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "semantic"
            },
            "hint": {
              "type": "string"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "manual"
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "IRVisibility": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "shared"
            }
          },
          "required": [
            "scope"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "scope": {
              "type": "string",
              "const": "private"
            },
