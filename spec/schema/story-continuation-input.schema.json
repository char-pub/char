{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v1-draft/story-continuation-input.schema.json",
  "title": "char.pub Reviewed Sequel Opening",
  "type": "object",
  "properties": {
    "scene": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "present": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_-]{0,31}$"
      }
    },
    "vars": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "boolean"
          },
          {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          {
            "type": "string"
          },
          {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        ]
      }
    },
    "knowing": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/StoryInfoRef"
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        }
      }
    },
    "opening": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "propertyNames": {
            "allOf": [
              {
                "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
              },
              {
                "pattern": "^(?!ref$)"
              }
            ],
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      ]
    }
  },
  "required": [
    "scene",
    "present",
    "vars",
    "knowing",
    "opening"
  ],
  "additionalProperties": false,
  "$defs": {
    "StoryInfoRef": {
      "type": "string",
      "pattern": "^(?:#[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?(?:\\/[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?){0,3}|@[a-z0-9][a-z0-9-]*\\/[a-z0-9][a-z0-9-]*#[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?(?:\\/[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?){0,3}|cast:[a-z0-9][a-z0-9_-]*#[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?(?:\\/[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?){0,3})$"
    },
    "Locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    }
  }
}
