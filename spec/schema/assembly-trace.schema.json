                      {
                        "type": "object",
                        "properties": {
                          "kind": {
                            "type": "string",
                            "const": "local-build"
                          },
                          "input_digest": {
                            "type": "string",
                            "pattern": "^sha256:[0-9a-f]{64}$"
                          }
                        },
                        "required": [
                          "kind",
                          "input_digest"
                        ],
                        "additionalProperties": false
                      }
                    ]
                  }
                },
                "required": [
                  "ref",
                  "semantic_digest",
                  "block",
                  "via",
                  "origin"
                ],
                "additionalProperties": false
              }
            ]
          },
          "policy_placement": {
            "type": "object",
            "properties": {
              "block": {
                "type": "string",
