                "type": "object",
                "properties": {
                  "creation": {
                    "$ref": "#/$defs/UnversionedRef"
                  },
                  "edge": {
                    "type": "string",
                    "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
                  },
                  "cast": {
                    "type": "string"
                  },
                  "op": {
                    "type": "string",
                    "enum": [
                      "replace",
                      "patch",
                      "add"
                    ]
                  }
                },
                "required": [
                  "creation",
                  "op"
                ],
                "additionalProperties": false
              }
            },
            "stable": {
              "type": "boolean"
            },
            "origin": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "draft-build"
                    },
                    "build_id": {
                      "type": "string",
                      "pattern": "^dbld_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                    },
                    "revision": {
                      "type": "string",
                      "pattern": "^rev_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                    },
                    "expires_at": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                    }
                  },
                  "required": [
                    "kind",
                    "build_id",
                    "revision",
                    "expires_at"
                  ],
