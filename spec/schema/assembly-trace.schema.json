                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "local-build"
                    },
                    "input_digest": {
                      "type": "string",
                      "pattern": "^sha256:[0-9a-f]{64}$"
                    }
                  },
                  "required": [
                    "kind",
                    "input_digest"
                  ],
                  "additionalProperties": false
                }
              ]
            }
          },
          "required": [
            "creation",
            "fragment",
            "via",
            "instance_key",
            "stable",
            "origin"
          ],
          "additionalProperties": false
        }
      ]
