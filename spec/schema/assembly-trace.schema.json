        {
          "type": "object",
          "properties": {
            "ref": {
              "$ref": "#/$defs/UnversionedRef"
            },
            "semantic_digest": {
              "$ref": "#/$defs/Digest"
            },
            "resolver": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
