{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v1-draft/assembly-fixture.schema.json",
  "title": "char.pub Assembly Fixture",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
    },
    "root": {
      "anyOf": [
        {
          "type": "string",
          "const": "self"
        },
        {
          "$ref": "#/$defs/ExactRef"
        }
      ]
    },
    "preset": {
      "anyOf": [
        {
          "type": "string",
          "const": "self"
        },
        {
          "$ref": "#/$defs/ExactRef"
        }
      ]
    },
    "profile": {
      "type": "object",
      "properties": {
        "runtime": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "string"
        },
        "tokenizer": {
          "type": "string"
        },
        "context_window": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "reserve_for_output": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "mode": {
          "type": "string",
          "enum": [
            "narrator",
            "per-agent"
          ]
        },
        "capabilities": {
          "type": "object",
          "properties": {
            "images": {
              "type": "boolean"
            },
            "system_role": {
              "type": "boolean"
            },
            "multiple_system_messages": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
        }
      },
      "required": [
        "runtime",
        "tokenizer",
        "context_window",
        "reserve_for_output",
        "mode",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "session": {
      "type": "object",
      "properties": {
        "locale": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
        },
        "bindings": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "persona",
                  "character"
                ]
              },
              "display_name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "outward_description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "display_name"
            ],
            "additionalProperties": false
          }
        },
        "history": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string",
                "enum": [
                  "user",
                  "assistant"
                ]
              },
              "speaker": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            },
            "required": [
              "role",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "manual_enabled": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "overlay": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "state": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "active_variants": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "for_participant": {
          "type": "string",
          "minLength": 1
        },
        "scene": {
          "type": "string",
          "minLength": 1
        },
        "visible_overlay": {
          "type": "object",
          "properties": {
            "memory": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "state": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string"
              }
            },
            "active_variants": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "additionalProperties": false
        },
        "present": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "story": {
          "$ref": "#/$defs/TurnStory"
        },
        "story_guidance": {
          "type": "boolean"
        },
        "focus": {
          "type": "string"
        },
        "judgments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "target": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "result": {
                "type": "string",
                "enum": [
                  "true",
                  "false",
                  "undetermined"
                ]
              },
              "provider": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "version": {
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "version"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "target",
              "path",
              "result",
              "provider"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "bindings",
        "history"
      ],
      "additionalProperties": false
    },
    "selection": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/CatalogRef"
      }
    },
    "source_texts": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "assembler": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "tokenizer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "expected": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "success"
            },
            "messages_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "trace": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "source": {
                    "type": "string",
                    "minLength": 1
                  },
                  "included": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "source"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false,
          "anyOf": [
            {
              "required": [
                "messages_digest"
              ]
            },
            {
              "required": [
                "trace"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "error"
            },
            "code": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "code"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "root",
    "profile",
    "session",
    "assembler",
    "tokenizer",
    "expected"
  ],
  "additionalProperties": false,
  "$defs": {
    "ExactRef": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "release",
        "semantic_digest"
      ],
      "additionalProperties": false
    },
    "TurnStory": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "visited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reached": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ended": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "happened": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "vars": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "integer",
                "minimum": -2147483648,
                "maximum": 2147483647
              },
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        },
        "knowing": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "stopped": {
          "type": "boolean"
        }
      },
      "required": [
        "start",
        "visited",
        "reached",
        "ended",
        "happened",
        "vars",
        "knowing",
        "stopped"
      ],
      "additionalProperties": false
    },
    "CatalogRef": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "work": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "work"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "fragment": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "fragment"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "group": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "group"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "source": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "source"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "story": {
              "type": "string",
              "enum": [
                "scene",
                "part",
                "goal",
                "beat",
                "ending"
              ]
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "story",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
