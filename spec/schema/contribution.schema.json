        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "availability": {
          "type": "string",
          "enum": [
            "mirrored",
            "linked"
          ]
        }
      },
      "required": [
        "digest",
        "size",
        "availability"
      ],
      "additionalProperties": false
