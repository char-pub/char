{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v0-draft/contribution.schema.json",
  "title": "char.pub Contribution",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^ctb_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "target": {
      "type": "string",
      "pattern": "^cr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "base": {
      "type": "object",
      "properties": {
        "revision": {
          "type": "string",
          "pattern": "^rev_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest"
        }
      },
      "required": [
        "revision",
        "semantic_digest"
      ],
      "additionalProperties": false
    },
    "author": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        {
          "$ref": "#/$defs/GuestAuthor"
        }
      ]
    },
    "agent": {
      "type": "boolean"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 20000
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "accepted",
        "rejected",
        "withdrawn"
      ]
    },
    "transport": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "native"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "github-pr"
            },
            "repository_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "number": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "type",
            "repository_id",
            "number"
          ],
          "additionalProperties": false
        }
      ]
    },
    "changes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/Change"
      }
    },
    "rights_ack": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "inbound_equals_outbound": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "inbound_equals_outbound"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "explicit_grant": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "explicit_grant"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "required": [
    "id",
    "target",
    "base",
    "author",
    "title",
    "status",
    "transport",
    "changes",
    "rights_ack"
  ],
  "additionalProperties": false,
  "$defs": {
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "GuestAuthor": {
      "type": "object",
      "properties": {
        "guest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "guest_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "Change": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "configuration"
            },
            "field": {
              "type": "string",
              "enum": [
                "policy",
                "prompt_module",
                "assembly",
                "assembly_tests"
              ]
            },
            "op": {
              "type": "string",
              "enum": [
                "set",
                "unset"
              ]
            },
            "base_digest": {
              "$ref": "#/$defs/Digest"
            },
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/PresetPolicy"
                },
                {
                  "$ref": "#/$defs/PromptModule"
                },
                {
                  "$ref": "#/$defs/AssemblyConfig"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/AssemblyFixture"
                  }
                }
              ]
            }
          },
          "required": [
            "on",
            "field",
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "fragment"
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "modify",
                "remove"
              ]
            },
            "id": {
              "$ref": "#/$defs/FragmentId"
            },
            "base_digest": {
              "$ref": "#/$defs/Digest"
            },
            "after": {
              "$ref": "#/$defs/Fragment"
            }
          },
          "required": [
            "on",
            "op",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "edge"
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "modify",
                "remove"
              ]
            },
            "id": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "base_digest": {
              "$ref": "#/$defs/Digest"
            },
            "after": {
              "$ref": "#/$defs/ReferenceEdge"
            }
          },
          "required": [
            "on",
            "op",
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "asset"
            },
            "op": {
              "type": "string",
              "enum": [
                "add",
                "modify",
                "remove"
              ]
            },
            "slot": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "variant": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "base_digest": {
              "$ref": "#/$defs/Digest"
            },
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AssetSlot"
                },
                {
                  "$ref": "#/$defs/AssetVariant"
                }
              ]
            }
          },
          "required": [
            "on",
            "op",
            "slot"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "on": {
              "type": "string",
              "const": "metadata"
            },
            "field": {
              "type": "string",
              "enum": [
                "display_name",
                "summary",
                "meta.default_locale",
                "meta.tags",
                "meta.rating",
                "meta.content_warnings",
                "meta.rights",
                "meta.license",
                "meta.recommended_presets",
                "meta.contribution_policy"
              ]
            },
            "op": {
              "type": "string",
              "enum": [
                "set",
                "unset"
              ]
            },
            "base_digest": {
              "$ref": "#/$defs/Digest"
            },
            "after": {
              "$ref": "#/$defs/JSONValue"
            },
            "sensitive": {
              "type": "boolean"
            }
          },
          "required": [
            "on",
            "field",
            "op",
            "sensitive"
          ],
          "additionalProperties": false
        }
      ]
    },
    "PresetPolicy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0-draft"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresetBlock"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PolicyImport"
          }
        },
        "layout": {
          "minItems": 15,
          "maxItems": 15,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "system:character",
              "system:cast",
              "session:bindings",
              "system:persona",
              "system:world",
              "system:scenario",
              "system:relationship",
              "system:knowledge",
              "system:style",
              "system:instruction",
              "system:examples",
              "session:memory",
              "session:state",
              "session:variants",
              "history"
            ]
          }
        },
        "region_budgets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "system:character",
              "system:cast",
              "system:persona",
              "system:world",
              "system:scenario",
              "system:relationship",
              "system:knowledge",
              "system:style",
              "system:instruction",
              "system:examples"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "requires": {
          "type": "object",
          "properties": {
            "system_role": {
              "type": "boolean",
              "const": true
            },
            "multiple_system_messages": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "system_role"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "blocks",
        "layout",
        "requires"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "layout": {
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "PresetBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "enum": [
            "main",
            "after-history"
          ]
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "text",
        "position"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "text": {
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "PolicyImport": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
        },
        "use": {
          "type": "string",
          "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "pin": {
          "type": "object",
          "properties": {
            "release": {
              "type": "string",
              "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
            },
            "semantic_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          },
          "required": [
            "release",
            "semantic_digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "use",
        "pin"
      ],
      "additionalProperties": false
    },
    "PromptModule": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0-draft"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PresetBlock"
          }
        },
        "imports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PolicyImport"
          }
        }
      },
      "required": [
        "version",
        "blocks"
      ],
      "additionalProperties": false
    },
    "AssemblyConfig": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0-draft"
        },
        "preset": {
          "$ref": "#/$defs/ExactRef"
        },
        "profile": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "model": {
              "type": "string"
            },
            "tokenizer": {
              "type": "string"
            },
            "context_window": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "reserve_for_output": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "type": "string",
              "enum": [
                "narrator",
                "per-agent"
              ]
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "images": {
                  "type": "boolean"
                },
                "system_role": {
                  "type": "boolean"
                },
                "multiple_system_messages": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "locale": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
            }
          },
          "required": [
            "runtime",
            "tokenizer",
            "context_window",
            "reserve_for_output",
            "mode",
            "capabilities"
          ],
          "additionalProperties": false
        },
        "assembler": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "tokenizer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "preset",
        "profile",
        "assembler",
        "tokenizer"
      ],
      "additionalProperties": false
    },
    "ExactRef": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "release",
        "semantic_digest"
      ],
      "additionalProperties": false
    },
    "AssemblyFixture": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
        },
        "root": {
          "anyOf": [
            {
              "type": "string",
              "const": "self"
            },
            {
              "$ref": "#/$defs/ExactRef"
            }
          ]
        },
        "preset": {
          "anyOf": [
            {
              "type": "string",
              "const": "self"
            },
            {
              "$ref": "#/$defs/ExactRef"
            }
          ]
        },
        "profile": {
          "type": "object",
          "properties": {
            "runtime": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "model": {
              "type": "string"
            },
            "tokenizer": {
              "type": "string"
            },
            "context_window": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "reserve_for_output": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "mode": {
              "type": "string",
              "enum": [
                "narrator",
                "per-agent"
              ]
            },
            "capabilities": {
              "type": "object",
              "properties": {
                "images": {
                  "type": "boolean"
                },
                "system_role": {
                  "type": "boolean"
                },
                "multiple_system_messages": {
                  "type": "boolean"
                }
              },
              "additionalProperties": false
            },
            "locale": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
            }
          },
          "required": [
            "runtime",
            "tokenizer",
            "context_window",
            "reserve_for_output",
            "mode",
            "capabilities"
          ],
          "additionalProperties": false
        },
        "session": {
          "type": "object",
          "properties": {
            "locale": {
              "type": "string",
              "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
            },
            "bindings": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string",
                "minLength": 1
              },
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "enum": [
                      "persona",
                      "character"
                    ]
                  },
                  "display_name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "kind",
                  "display_name"
                ],
                "additionalProperties": false
              }
            },
            "history": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "role": {
                    "type": "string",
                    "enum": [
                      "user",
                      "assistant"
                    ]
                  },
                  "speaker": {
                    "type": "string"
                  },
                  "text": {
                    "type": "string"
                  }
                },
                "required": [
                  "role",
                  "text"
                ],
                "additionalProperties": false
              }
            },
            "manual_enabled": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "overlay": {
              "type": "object",
              "properties": {
                "memory": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "state": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "active_variants": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "additionalProperties": false
            },
            "for_participant": {
              "type": "string",
              "minLength": 1
            },
            "scene": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "bindings",
            "history"
          ],
          "additionalProperties": false
        },
        "assembler": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "tokenizer": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "expected": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "success"
                },
                "messages_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "trace": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "source": {
                        "type": "string",
                        "minLength": 1
                      },
                      "included": {
                        "type": "boolean"
                      },
                      "reason": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "source"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "anyOf": [
                {
                  "required": [
                    "messages_digest"
                  ]
                },
                {
                  "required": [
                    "trace"
                  ]
                }
              ]
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "error"
                },
                "code": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "code"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "id",
        "root",
        "profile",
        "session",
        "assembler",
        "tokenizer",
        "expected"
      ],
      "additionalProperties": false
    },
    "FragmentId": {
      "type": "string",
