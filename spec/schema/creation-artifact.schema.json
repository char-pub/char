{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v0-draft/creation-artifact.schema.json",
  "title": "char.pub Creation Artifact",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0-draft"
        },
        "root": {
          "$ref": "#/$defs/ExactRef"
        },
        "lock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockEntry"
          }
        },
        "lock_digest": {
          "$ref": "#/$defs/Digest"
        },
        "meta": {
          "$ref": "#/$defs/EffectiveMeta"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IRAsset"
          }
        },
        "kind": {
          "type": "string",
          "const": "content"
        },
        "ir": {
          "type": "object",
          "properties": {
            "ir_version": {
              "type": "string",
              "const": "0-draft"
            },
            "root": {
              "type": "object",
              "properties": {
                "ref": {
                  "$ref": "#/$defs/UnversionedRef"
                },
                "release": {
                  "type": "string",
                  "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                },
                "semantic_digest": {
                  "$ref": "#/$defs/Digest"
                }
              },
              "required": [
                "ref",
                "release",
                "semantic_digest"
              ],
              "additionalProperties": false
            },
            "lock_digest": {
              "$ref": "#/$defs/Digest"
            },
            "resolver": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "version": {
                  "type": "string"
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "meta": {
              "$ref": "#/$defs/EffectiveMeta"
            },
            "participants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Participant"
              }
            },
            "late_slots": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LateSlot"
              }
            },
            "fragments": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IRFragment"
              }
            },
            "bootstrap": {
              "type": "object",
              "properties": {
                "greetings": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "speaker": {
                        "type": "string"
                      },
                      "text": {
                        "type": "string"
                      },
                      "locales": {
                        "type": "object",
                        "propertyNames": {
                          "$ref": "#/$defs/Locale"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      },
                      "scenario_hint": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "id",
                      "speaker",
                      "text"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "greetings"
              ],
              "additionalProperties": false
            },
            "assets": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/IRAsset"
              }
            },
            "graph": {
              "$ref": "#/$defs/IRGraph"
            },
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string"
                  },
                  "subject": {
                    "type": "string"
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "info",
                      "warning"
                    ]
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "code",
                  "subject",
                  "severity"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "ir_version",
            "root",
            "lock_digest",
            "resolver",
            "meta",
            "participants",
            "late_slots",
            "fragments",
            "bootstrap",
            "assets",
            "graph",
            "diagnostics"
          ],
          "additionalProperties": false
        },
        "assembly": {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "0-draft"
            },
            "profile": {
              "type": "object",
              "properties": {
                "runtime": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "name",
                    "version"
                  ],
                  "additionalProperties": false
                },
                "model": {
                  "type": "string"
                },
                "tokenizer": {
                  "type": "string"
                },
                "context_window": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "reserve_for_output": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "mode": {
                  "type": "string",
                  "enum": [
                    "narrator",
                    "per-agent"
                  ]
                },
                "capabilities": {
                  "type": "object",
                  "properties": {
                    "images": {
                      "type": "boolean"
                    },
                    "system_role": {
                      "type": "boolean"
                    },
                    "multiple_system_messages": {
                      "type": "boolean"
                    }
                  },
                  "additionalProperties": false
                },
                "locale": {
                  "type": "string",
                  "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
                }
              },
              "required": [
                "runtime",
                "tokenizer",
                "context_window",
                "reserve_for_output",
                "mode",
                "capabilities"
              ],
              "additionalProperties": false
            },
            "assembler": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "tokenizer": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "preset": {
              "$ref": "#/$defs/ResolvedPreset"
            }
          },
          "required": [
            "version",
            "profile",
            "assembler",
            "tokenizer",
            "preset"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "root",
        "lock",
        "lock_digest",
        "meta",
        "assets",
        "kind",
        "ir"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0-draft"
        },
        "root": {
          "$ref": "#/$defs/ExactRef"
        },
        "lock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockEntry"
          }
        },
        "lock_digest": {
          "$ref": "#/$defs/Digest"
        },
        "meta": {
          "$ref": "#/$defs/EffectiveMeta"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IRAsset"
          }
        },
        "kind": {
          "type": "string",
          "const": "preset"
        },
        "preset": {
          "$ref": "#/$defs/ResolvedPreset"
        }
      },
      "required": [
        "version",
        "root",
        "lock",
        "lock_digest",
        "meta",
        "assets",
        "kind",
        "preset"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0-draft"
        },
        "root": {
          "$ref": "#/$defs/ExactRef"
        },
        "lock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockEntry"
          }
        },
        "lock_digest": {
          "$ref": "#/$defs/Digest"
        },
        "meta": {
          "$ref": "#/$defs/EffectiveMeta"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/IRAsset"
          }
        },
        "kind": {
          "type": "string",
          "const": "prompt-module"
        },
        "module": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "release": {
              "type": "string",
              "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
            },
            "semantic_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "resolver": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "name",
                "version"
              ],
              "additionalProperties": false
            },
            "version": {
              "type": "string",
              "const": "0-draft"
            },
            "blocks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ResolvedPolicyBlock"
              }
            },
            "lock": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/LockEntry"
              }
            },
            "lock_digest": {
              "$ref": "#/$defs/Digest"
            }
          },
          "required": [
            "ref",
            "release",
            "semantic_digest",
            "resolver",
            "version",
            "blocks",
            "lock",
            "lock_digest"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "root",
        "lock",
        "lock_digest",
        "meta",
        "assets",
        "kind",
        "module"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "ExactRef": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "required": [
        "ref",
        "release",
        "semantic_digest"
      ],
      "additionalProperties": false
    },
    "LockEntry": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest"
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          }
        }
      },
      "required": [
        "ref",
        "release",
        "semantic_digest",
        "via"
      ],
      "additionalProperties": false
    },
    "UnversionedRef": {
      "type": "string",
      "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "EffectiveMeta": {
      "type": "object",
      "properties": {
        "default_locale": {
          "$ref": "#/$defs/Locale"
        },
        "available_locales": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Locale"
          }
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        },
        "rating_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "rating": {
                "$ref": "#/$defs/Rating"
              },
              "asset": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "rating"
            ],
            "additionalProperties": false
          }
        },
        "content_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "licenses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "license": {
                "$ref": "#/$defs/SpdxExpression"
              },
              "asset": {
                "type": "string"
              }
            },
            "required": [
              "ref",
              "license"
            ],
            "additionalProperties": false
          }
        },
        "attribution": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "authors": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/AttributionAuthor"
                }
              }
            },
            "required": [
              "ref",
              "authors"
            ],
            "additionalProperties": false
          }
        },
        "contributors": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "author": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                  },
                  {
                    "$ref": "#/$defs/GuestAuthor"
                  }
                ]
              },
              "contribution": {
                "type": "string",
                "pattern": "^ctb_[0-7][0-9a-hjkmnp-tv-z]{25}$"
              }
            },
            "required": [
              "ref",
              "author"
            ],
            "additionalProperties": false
          }
        },
        "import_omissions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "$ref": "#/$defs/UnversionedRef"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "ref",
              "fields"
            ],
            "additionalProperties": false
          }
        },
        "au": {
          "type": "boolean"
        },
        "recommended_presets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/UnversionedRef"
          }
        }
      },
      "required": [
        "default_locale",
        "available_locales",
        "rating",
        "rating_sources",
        "content_warnings",
        "licenses",
        "attribution",
        "contributors",
        "import_omissions",
        "au",
        "recommended_presets"
      ],
      "additionalProperties": false
    },
    "Locale": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{1,8})*$"
    },
    "Rating": {
      "type": "string",
      "enum": [
        "general",
        "teen",
        "mature",
        "explicit"
      ]
    },
    "SpdxExpression": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9.+\\-() :]+$"
    },
    "AttributionAuthor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "user": {
          "type": "string",
          "pattern": "^usr_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "guest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "contribution": {
          "type": "string",
          "pattern": "^ctb_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "GuestAuthor": {
      "type": "object",
      "properties": {
        "guest_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "required": [
        "guest_id",
        "display_name"
      ],
      "additionalProperties": false
    },
    "IRAsset": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "presentation",
            "context"
          ]
        },
        "media_type": {
          "type": "string"
        },
        "digest": {
          "$ref": "#/$defs/Digest"
        },
        "availability": {
          "type": "string",
          "enum": [
            "mirrored",
            "linked"
          ]
        },
        "access": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        },
        "url": {
          "type": "string"
        },
        "locator": {
          "$ref": "#/$defs/SourceLocator"
        },
        "alt": {
          "type": "string"
        },
        "rating": {
          "$ref": "#/$defs/Rating"
        },
        "license": {
          "$ref": "#/$defs/SpdxExpression"
        },
        "origin": {
          "type": "object",
          "properties": {
            "creation": {
              "$ref": "#/$defs/UnversionedRef"
            },
            "release": {
              "type": "string",
              "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
            },
            "slot": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "variant": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "instance_key": {
              "type": "string"
            }
          },
          "required": [
            "creation",
            "release",
            "slot",
            "variant",
            "instance_key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "role",
        "media_type",
        "digest",
        "availability",
        "access",
        "rating",
        "license",
        "origin"
      ],
      "additionalProperties": false
    },
    "SourceLocator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "github"
            },
            "repository_id": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "commit": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "provider",
            "repository_id",
            "commit",
            "path"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "const": "http"
            },
            "url": {
              "type": "string",
              "pattern": "^https:\\/\\/",
              "format": "uri"
            }
          },
          "required": [
            "provider",
            "url"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Participant": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "display_name": {
          "$ref": "#/$defs/LocalizedText"
        },
        "kind": {
          "type": "string",
          "enum": [
            "character",
            "persona"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "lead",
            "support",
            "user"
          ]
        },
        "late": {
          "type": "string"
        },
        "avatar": {
          "type": "string"
        }
      },
      "required": [
        "key",
        "display_name",
        "kind"
      ],
      "additionalProperties": false
    },
    "LocalizedText": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    },
    "LateSlot": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "accepts": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "persona",
              "character"
            ]
          }
        },
        "required": {
          "type": "boolean"
        },
        "hint": {
          "type": "string"
        },
        "used_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "key",
        "accepts",
        "required",
        "used_by"
      ],
      "additionalProperties": false
    },
    "IRFragment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "$ref": "#/$defs/FragmentKind"
        },
        "content": {
          "$ref": "#/$defs/IRContent"
        },
        "locales": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/Locale"
          },
          "additionalProperties": {
            "$ref": "#/$defs/IRContent"
