{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v1-draft/resolved-preset.schema.json",
  "title": "char.pub Resolved Preset",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest"
        },
        "resolver": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "policy": {
          "$ref": "#/$defs/ResolvedPolicy"
        },
        "lock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockEntry"
          }
        },
        "lock_digest": {
          "$ref": "#/$defs/Digest"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        }
      },
      "required": [
        "ref",
        "semantic_digest",
        "resolver",
        "policy",
        "release"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest"
        },
        "resolver": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "policy": {
          "$ref": "#/$defs/ResolvedPolicy"
        },
        "lock": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LockEntry"
          }
        },
        "lock_digest": {
          "$ref": "#/$defs/Digest"
        },
        "origin": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "draft-build"
                },
                "build_id": {
                  "type": "string",
                  "pattern": "^dbld_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                },
                "revision": {
                  "type": "string",
                  "pattern": "^rev_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                },
                "expires_at": {
                  "type": "string",
                  "format": "date-time",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                }
              },
              "required": [
                "kind",
                "build_id",
                "revision",
                "expires_at"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "local-build"
                },
                "input_digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                }
              },
              "required": [
                "kind",
                "input_digest"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "ref",
        "semantic_digest",
        "resolver",
        "policy",
        "origin"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "UnversionedRef": {
      "type": "string",
      "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ResolvedPolicy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "1-draft"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedPolicyBlock"
          }
        },
        "selection": {
          "type": "object",
          "properties": {
            "catalog_budget": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "max_depth": {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            "on_unavailable": {
              "type": "string",
              "const": "skip"
            }
          },
          "additionalProperties": false
        },
        "render": {
          "type": "object",
          "properties": {
            "perspective.rumor": {
              "type": "string",
              "minLength": 1
            },
            "perspective.claim": {
              "type": "string",
              "minLength": 1
            },
            "perspective.belief": {
              "type": "string",
              "minLength": 1
            },
            "knowing.narrator": {
              "type": "string",
              "minLength": 1
            },
            "sources.notice": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "layout": {
          "minItems": 18,
          "maxItems": 18,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "system:character",
              "system:cast",
              "session:bindings",
              "system:persona",
              "system:world",
              "system:scenario",
              "system:scene",
              "system:story",
              "system:sources",
              "system:relationship",
              "system:knowledge",
              "system:style",
              "system:instruction",
              "system:examples",
              "session:memory",
              "session:state",
              "session:variants",
              "history"
            ]
          }
        },
        "region_budgets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "system:character",
              "system:cast",
              "system:persona",
              "system:world",
              "system:scenario",
              "system:scene",
              "system:story",
              "system:sources",
              "system:relationship",
              "system:knowledge",
              "system:style",
              "system:instruction",
              "system:examples"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "requires": {
          "type": "object",
          "properties": {
            "system_role": {
              "type": "boolean",
              "const": true
            },
            "multiple_system_messages": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "system_role"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "blocks",
        "layout",
        "requires"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "layout": {
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "ResolvedPolicyBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^(?:[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?|@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?#[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?)(?:~(?:main|after-history)~[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?)?$"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "origin": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "$ref": "#/$defs/UnversionedRef"
                },
                "semantic_digest": {
                  "$ref": "#/$defs/Digest"
                },
                "block": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
                },
                "via": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
                  }
                },
                "release": {
                  "type": "string",
                  "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                }
              },
              "required": [
                "ref",
                "semantic_digest",
                "block",
                "via",
                "release"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "ref": {
                  "$ref": "#/$defs/UnversionedRef"
                },
                "semantic_digest": {
                  "$ref": "#/$defs/Digest"
                },
                "block": {
                  "type": "string",
                  "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
                },
                "via": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
                  }
                },
                "origin": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "draft-build"
                        },
                        "build_id": {
                          "type": "string",
                          "pattern": "^dbld_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                        },
                        "revision": {
                          "type": "string",
                          "pattern": "^rev_[0-7][0-9a-hjkmnp-tv-z]{25}$"
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time",
                          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                        }
                      },
                      "required": [
                        "kind",
                        "build_id",
                        "revision",
                        "expires_at"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "local-build"
                        },
                        "input_digest": {
                          "type": "string",
                          "pattern": "^sha256:[0-9a-f]{64}$"
                        }
                      },
                      "required": [
                        "kind",
                        "input_digest"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "ref",
                "semantic_digest",
                "block",
                "via",
                "origin"
              ],
              "additionalProperties": false
            }
          ]
        },
        "position": {
          "type": "string",
          "enum": [
            "main",
            "after-history"
          ]
        },
        "placement": {
          "type": "object",
          "properties": {
            "block": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?(?:\\/[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?)*$"
            },
            "at": {
              "type": "string",
              "enum": [
                "main",
                "after-history"
              ]
            },
            "as": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            }
          },
          "required": [
            "block",
            "at"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "text",
        "position"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "text": {
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "LockEntry": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest"
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          }
        }
      },
      "required": [
        "ref",
        "release",
        "semantic_digest",
        "via"
      ],
      "additionalProperties": false
    }
  }
}
