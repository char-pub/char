{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://char.pub/schema/v0-draft/resolved-preset.schema.json",
  "title": "char.pub Resolved Preset",
  "type": "object",
  "properties": {
    "ref": {
      "$ref": "#/$defs/UnversionedRef"
    },
    "release": {
      "type": "string",
      "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
    },
    "semantic_digest": {
      "$ref": "#/$defs/Digest"
    },
    "resolver": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "policy": {
      "$ref": "#/$defs/ResolvedPolicy"
    },
    "lock": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/LockEntry"
      }
    },
    "lock_digest": {
      "$ref": "#/$defs/Digest"
    }
  },
  "required": [
    "ref",
    "release",
    "semantic_digest",
    "resolver",
    "policy"
  ],
  "additionalProperties": false,
  "$defs": {
    "UnversionedRef": {
      "type": "string",
      "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ResolvedPolicy": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "const": "0-draft"
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolvedPolicyBlock"
          }
        },
        "layout": {
          "minItems": 15,
          "maxItems": 15,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "system:character",
              "system:cast",
              "session:bindings",
              "system:persona",
              "system:world",
              "system:scenario",
              "system:relationship",
              "system:knowledge",
              "system:style",
              "system:instruction",
              "system:examples",
              "session:memory",
              "session:state",
              "session:variants",
              "history"
            ]
          }
        },
        "region_budgets": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "enum": [
              "system:character",
              "system:cast",
              "system:persona",
              "system:world",
              "system:scenario",
              "system:relationship",
              "system:knowledge",
              "system:style",
              "system:instruction",
              "system:examples"
            ]
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "requires": {
          "type": "object",
          "properties": {
            "system_role": {
              "type": "boolean",
              "const": true
            },
            "multiple_system_messages": {
              "type": "boolean",
              "const": true
            }
          },
          "required": [
            "system_role"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "version",
        "blocks",
        "layout",
        "requires"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "layout": {
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "ResolvedPolicyBlock": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            {
              "type": "string",
              "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?#[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            }
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "string",
          "enum": [
            "main",
            "after-history"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "origin": {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^@[a-z0-9](?:[a-z0-9-]{0,37}[a-z0-9])?\\/[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
            },
            "release": {
              "type": "string",
              "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
            },
            "semantic_digest": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "block": {
              "type": "string",
              "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
            },
            "via": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
              }
            }
          },
          "required": [
            "ref",
            "release",
            "semantic_digest",
            "block",
            "via"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "text",
        "position"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "properties": {
            "text": {
              "pattern": "\\S"
            }
          }
        }
      ]
    },
    "LockEntry": {
      "type": "object",
      "properties": {
        "ref": {
          "$ref": "#/$defs/UnversionedRef"
        },
        "release": {
          "type": "string",
          "pattern": "^rel_[0-7][0-9a-hjkmnp-tv-z]{25}$"
        },
        "semantic_digest": {
          "$ref": "#/$defs/Digest"
        },
        "via": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9](?:[a-z0-9_-]{0,62}[a-z0-9])?$"
          }
        }
      },
      "required": [
        "ref",
        "release",
        "semantic_digest",
        "via"
      ],
      "additionalProperties": false
    }
  }
}
