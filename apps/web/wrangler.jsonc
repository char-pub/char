// www.char.pub：纯静态资源的 SPA，部署在 Cloudflare Workers Static Assets。
// 没有 Worker 脚本，所以 public/_headers 中的安全响应头对所有响应生效。
// 部署前必须先构建（`pnpm --filter @char-pub/web build`）。自定义域名由 deploy 自动绑定并
// 创建 DNS 记录，所以这个域名事先不能有 CNAME。
{
  "$schema": "https://unpkg.com/wrangler@4.136.0/config-schema.json",
  "name": "charpub-web",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/",
    "not_found_handling": "single-page-application"
  },
  "routes": [{ "pattern": "www.char.pub", "custom_domain": true }]
}
