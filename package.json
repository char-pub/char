{
  "name": "char-pub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.tests.json && tsc -p apps/web/tsconfig.node.json",
    "deps": "depcruise packages apps actions spec/conformance/runner spec/conformance/scripts --config .dependency-cruiser.cjs",
    "test": "vitest run --project unit --project server-unit --project web",
    "test:unit": "vitest run --project unit --project server-unit --coverage",
    "test:web": "vitest run --project web",
    "test:conformance": "vitest run --project conformance-node --project conformance-browser --project conformance-workerd",
    "test:integration": "vitest run --project integration --project server-unit --coverage --coverage.include=apps/server/src/** --coverage.exclude=apps/server/src/db/schema/** --coverage.reportsDirectory=coverage/server",
    "build": "pnpm -r --if-present build",
    "schema:export": "tsx --conditions=@char-pub/source packages/core/scripts/export-json-schema.ts",
    "conformance:bundle": "tsx --conditions=@char-pub/source spec/conformance/scripts/bundle.ts",
    "conformance:draft": "tsx --conditions=@char-pub/source spec/conformance/scripts/draft.ts",
    "conformance:accept": "tsx --conditions=@char-pub/source spec/conformance/scripts/accept.ts",
    "conformance:precheck": "tsx --conditions=@char-pub/source spec/conformance/scripts/precheck.ts",
    "conformance:review": "tsx --conditions=@char-pub/source spec/conformance/scripts/review.ts",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d --wait",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "secrets": "gitleaks git --redact --no-banner . && gitleaks dir --redact --no-banner .",
    "ci:all": "pnpm lint && pnpm typecheck && pnpm deps && pnpm test:unit && pnpm test:web && pnpm test:conformance && pnpm test:integration && pnpm build && pnpm check:action-dist && pnpm secrets",
    "prepare": "lefthook install || true",
    "check:action-dist": "pnpm --filter @char-pub/publish-action build && git diff --exit-code -- actions/publish/dist"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "dependency-cruiser": "catalog:",
    "fast-check": "catalog:",
    "lefthook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
