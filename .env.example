# 只写变量名与说明，真实值放在 Railway variables / Cloudflare secrets（仓库是 public 的）。
# 本地开发默认值见 infra/docker-compose.yml。

# Postgres（本地：docker compose）
DATABASE_URL=
# 迁移使用的 owner 角色（应用运行时使用非 owner 角色 DATABASE_URL）
DATABASE_MIGRATION_URL=

# S3 兼容存储（本地 MinIO；线上 R2 S3 endpoint）
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_BUCKET_UPLOADS=
S3_BUCKET_EVIDENCE=
PUBLIC_ASSETS_BASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App（Source）
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# 边缘与 admin
ORIGIN_AUTH_SECRET=
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
TURNSTILE_SECRET_KEY=
