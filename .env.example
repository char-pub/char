# 只写变量名与说明，真实值放在 Railway variables / Cloudflare secrets（仓库是 public 的）。
# 本地开发默认值见 infra/docker-compose.yml。

# Postgres（本地：docker compose）
# 应用运行时使用的非 owner 角色连接串
DATABASE_URL=
DATABASE_POOL_MAX=10
# 迁移使用的 owner 角色连接串（部署前执行 `pnpm --filter @char-pub/server db:migrate`）
DATABASE_MIGRATION_URL=
# 迁移结束时授予最小权限的应用角色名
DATABASE_APP_ROLE=charpub_app

# 进程
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# S3 兼容存储（本地 MinIO；线上 R2 S3 endpoint）
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_PUBLIC=
S3_BUCKET_PRIVATE=
S3_BUCKET_UPLOADS=
S3_BUCKET_EVIDENCE=
PUBLIC_ASSETS_BASE_URL=

# Better Auth（创作者登录）
# 至少 32 个字符的随机值，例如 `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# API 的外部地址，例如 https://api.char.pub；OAuth 回调地址是 <BETTER_AUTH_URL>/v1/auth/callback/<provider>
BETTER_AUTH_URL=
# 允许发起登录与写请求的前端 Origin，逗号分隔，例如 https://www.char.pub
AUTH_TRUSTED_ORIGINS=
# 第三方登录：client id 与 secret 必须成对设置；留空的 provider 不启用
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub App（Source）
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# 边缘与 admin
# Cloudflare 回源时附带的源站校验值（至少 32 个字符）；轮换期间把旧值放进 _PREVIOUS
ORIGIN_AUTH_SECRET=
ORIGIN_AUTH_SECRET_PREVIOUS=
# admin 进程：Cloudflare Access 团队域名、应用 AUD、员工邮箱（逗号分隔）、admin SPA Origin
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
STAFF_EMAILS=
ADMIN_ORIGINS=
TURNSTILE_SECRET_KEY=

# worker：自动处置的系统执行者（auth_user 中预置的账号 ID）与 CDN 缓存清除
SYSTEM_ACTOR_ID=
CF_ZONE_ID=
CF_PURGE_TOKEN=
